---
import { cva } from '../utils/cva.config'

const buttonVariants = cva({
  base: 'inline-block rounded-sm text-base leading-none font-bold whitespace-nowrap ring-offset-white transition-colors hover:no-underline focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-hidden disabled:pointer-events-none disabled:opacity-50',
  variants: {
    variant: {
      bordered:
        'border-darkgray/30 text-darkgray/80 hover:border-darkgray/60 border',
      colored: 'text-lightgray',
    },
    size: {
      large: 'px-3 py-3 min-[500px]:px-4 xl:px-4',
      default: 'px-3 py-3',
    },
    color: {
      unset: 'hover:text-darkgray',
      green: 'bg-green/15 text-darkgreen',
      blue: 'bg-blue/15 text-darkblue',
      orange: 'bg-orange/15 text-darkorange',
    },
  },
  defaultVariants: {
    color: 'unset',
    size: 'default',
  },
})

const { className, variant, size, color, href, ...rest } = Astro.props
---

{
  href ? (
    <a
      class={buttonVariants({ variant, size, color, className })}
      href={href}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      class={buttonVariants({ variant, size, color, className })}
      type="button"
      {...rest}
    >
      <slot />
    </button>
  )
}
